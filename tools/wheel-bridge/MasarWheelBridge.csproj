<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MASAR Wheel Bridge: reads a racing wheel on Windows (Windows.Gaming.Input, built into
    Windows: no third-party SDK) and streams it to the MASAR game on the iPad over the local
    network. Force feedback comes back from the game and drives the wheel's motor.
    Build: dotnet publish tools/wheel-bridge -c Release -o build/wheel-bridge
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MasarWheelBridge</AssemblyName>
    <RootNamespace>Masar.WheelBridge</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.DirectInput" Version="3.8.3" />
  </ItemGroup>

</Project>
